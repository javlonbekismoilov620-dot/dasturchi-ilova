# Copy to .env.local (development) or set as EAS environment variables (builds).
# Leave the Supabase values empty to run the app in clearly-labelled DEMO MODE.

# Supabase project (Settings → API). The anon/publishable key is designed to be public;
# Row Level Security protects the data. NEVER put the service-role/secret key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat public SDK keys (Project settings → API keys). Leave empty to disable purchases.
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=

# Build-time only
APP_ENV=development        # development | preview | production
EAS_PROJECT_ID=            # from `eas init`; enables push tokens and EAS Update
EAS_OWNER=
