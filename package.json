{
  "name": "mahorat",
  "private": true,
  "version": "1.0.0",
  "description": "Mahorat — premium learning ecosystem: Expo mobile app, admin CMS and Supabase backend.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start -w @mahorat/mobile",
    "admin": "npm run dev -w @mahorat/admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "bash supabase/tests/run.sh"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "supabase": "^3.1.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
